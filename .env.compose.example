# Copy to .env and replace every CHANGE_ME value before Compose startup.
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_DATABASE=mydatabase
DB_USER=root
JWT_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_VALUE
REFRESH_TOKEN_PEPPER=CHANGE_ME_WITH_AN_INDEPENDENT_LONG_RANDOM_VALUE
SESSION_METADATA_PEPPER=CHANGE_ME_WITH_ANOTHER_INDEPENDENT_RANDOM_VALUE
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=
JWT_ALGORITHM=RS256
JWT_ACTIVE_KID=primary
JWT_ISSUER=bc-dentistry-auth
JWT_AUDIENCE=bc-dentistry-api
ACCESS_TOKEN_TTL=10m
WEB_SESSION_IDLE_TTL=30m
WEB_SESSION_ABSOLUTE_TTL=8h
MOBILE_SESSION_IDLE_TTL=7d
MOBILE_SESSION_ABSOLUTE_TTL=30d
SESSION_RETENTION_DAYS=90
APPOINTMENT_DEFAULT_DURATION_MINUTES=30
CORS_ORIGIN=http://localhost:5173
# Independent high-entropy credential used only between application services.
BLOCKCHAIN_INTERNAL_TOKEN=CHANGE_ME_WITH_AN_INDEPENDENT_LONG_RANDOM_VALUE

# Generated by the separately managed Fabric test network.
FABRIC_CONNECTION_DIR=./dental-backend/connection
FABRIC_WALLET_DIR=./dental-backend/wallet
FABRIC_CHANNEL=mychannel
FABRIC_CHAINCODE=basic
FABRIC_DISCOVERY_ENABLED=true
# Local test-network compatibility only; production must verify CA TLS.
FABRIC_CA_TLS_VERIFY=false

WEB_PORT=5173
MYSQL_PORT=3306
RADIOGRAPHIC_MAX_FILE_BYTES=536870912

# Shared Firebase Cloud Messaging configuration.
# Base64-encode the complete Firebase service-account JSON as a single line.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_BASE64=
WEB_APP_URL=http://localhost:5173
PUSH_TOKEN_STALE_DAYS=60

# Firebase web-app configuration and Web Push certificate public key.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
