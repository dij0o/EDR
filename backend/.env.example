# =============================================================================
# Database API (dental-database-backend) — environment configuration
# Copy this file to `.env` and fill in real values. Do NOT commit the real .env.
# =============================================================================

PORT=8080

# MySQL connection
# When running via docker-compose, set DB_HOST=mysql (the service name).
# When running the API directly on the host, use DB_HOST=localhost.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mydatabase
DB_USER=root

# Provided separately through a secure channel — do not commit the real value.
DB_PASSWORD=CHANGE_ME

# Authentication — generate a strong random secret (see dental-backend example)
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=8h

# Optional one-time deployment secret for POST /register when no Admin/System JWT
# is available yet. Leave unset after initial AWS VM bootstrap if not needed.
ADMIN_BOOTSTRAP_TOKEN=CHANGE_ME

# Peer service URLs
# If backend runs directly on the host, use http://localhost:8081.
# If backend runs in Docker while dental-backend runs on the host, Docker Desktop
# users can use http://host.docker.internal:8081.
BLOCKCHAIN_API_URL=http://localhost:8081

# Web frontend origin allowed to call this API.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
