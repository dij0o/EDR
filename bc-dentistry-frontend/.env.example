# =============================================================================
# Web Frontend (React.js / Vite) — environment configuration
# Copy this file to `.env`. Vite only exposes variables prefixed with VITE_.
# =============================================================================

VITE_BLOCKCHAIN_API_URL=http://localhost:8081
VITE_DATABASE_API_URL=http://localhost:8080

# Docker Compose builds the frontend with same-origin proxy paths instead:
# VITE_DATABASE_API_URL=/api/database
# VITE_BLOCKCHAIN_API_URL=/api/blockchain
