{
    "name": "dental-record-sharing",
    "version": "1.0.0",
    "description": "Dental-Record-Sharing contract implemented in JavaScript",
    "main": "index.js",
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "lint": "eslint index.js lib test",
        "pretest": "npm run lint",
        "test": "nyc mocha --recursive",
        "start": "fabric-chaincode-node start"
    },
    "engineStrict": true,
    "author": "Hyperledger",
    "license": "Apache-2.0",
    "dependencies": {
        "fabric-contract-api": "~2.5",
        "fabric-shim": "~2.5",
        "json-stringify-deterministic": "^1.0.0",
        "sort-keys-recursive": "^2.1.0"
    },
    "devDependencies": {
        "chai": "^4.4.1",
        "eslint": "^8.57.0",
        "mocha": "^11.8.0",
        "nyc": "^18.0.0",
        "sinon": "^18.0.1",
        "sinon-chai": "^3.7.0"
    },
    "overrides": {
        "diff": "9.0.0",
        "serialize-javascript": "7.0.7"
    },
    "nyc": {
        "exclude": [
            "coverage/**",
            "test/**",
            "index.js",
            ".eslintrc.js"
        ],
        "reporter": [
            "text-summary",
            "html"
        ],
        "all": true,
        "check-coverage": true,
        "statements": 15,
        "branches": 14,
        "functions": 32,
        "lines": 15
    }
}
